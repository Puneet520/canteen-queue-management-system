# Copy this file to .env and fill in real values before running the server

# PostgreSQL connection string
# Local example: postgresql://postgres:password@localhost:5432/canteen_db
# Hosted example (Supabase/Neon/Railway): use the connection string they give you
DATABASE_URL="postgresql://postgres:password@localhost:5432/canteen_db"

# Port the API server listens on
PORT=5000

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call the API (your frontend URL)
CLIENT_ORIGIN="http://localhost:5173"
