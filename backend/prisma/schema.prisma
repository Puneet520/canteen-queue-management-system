
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  orders  Order[]
  reviews Review[]
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Decimal     @db.Decimal(10, 2)
  category        String      @default("General")
  prepTimeMinutes Int         @default(4)
  station         String      @default("Main")
  isAvailable     Boolean     @default(true)
  stockQty        Int         @default(0)

  imageUrl    String?
  foodType    FoodType @default(VEG)
  isJain      Boolean  @default(false)
  allergens   String[]
  calories    Int?
  protein     Int?
  carbs       Int?
  fat         Int?
  avgRating   Float    @default(0)
  ratingCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  reviews    Review[]
}

model Order {
  id               String      @id @default(uuid())
  token            String      @unique
  pickupPin        String      @default("0000")
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal     @db.Decimal(10, 2)
  queuePosition    Int?
  estimatedMinutes Int         @default(5)
  scheduledSlot    String?
  scheduledDate    String?
  startedPrepAt    DateTime?
  readyAt          DateTime?
  collectedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items OrderItem[]

  reviews Review[]

  @@index([status, createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating     Int // 1..5, validated in the controller
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId, orderId])
  @@index([menuItemId])
}