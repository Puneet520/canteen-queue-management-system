generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  orders       Order[]
  reviews      Review[]
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Decimal     @db.Decimal(10, 2)
  category        String      @default("General")
  isAvailable     Boolean     @default(true)
  stockQty        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  prepTimeMinutes Int         @default(4)
  station         String      @default("Main")
  allergens       String[]
  avgRating       Float       @default(0)
  calories        Int?
  carbs           Int?
  fat             Int?
  foodType        FoodType    @default(VEG)
  imageUrl        String?
  isJain          Boolean     @default(false)
  protein         Int?
  ratingCount     Int         @default(0)
  orderItems      OrderItem[]
  reviews         Review[]
}

model Order {
  id               String      @id @default(uuid())
  token            String      @unique
  userId           String
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal     @db.Decimal(10, 2)
  paymentExpiresAt DateTime?
  queuePosition    Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  collectedAt      DateTime?
  estimatedMinutes Int         @default(5)
  pickupPin        String      @default("0000")
  readyAt          DateTime?
  startedPrepAt    DateTime?
  scheduledDate    String?
  scheduledSlot    String?
  tableNumber      String?
  user             User        @relation(fields: [userId], references: [id])
  items            OrderItem[]
  paymentAttempts  Payment[]
  reviews          Review[]

  @@index([status, createdAt])
  @@index([status, paymentExpiresAt])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  method            String?
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  orderId    String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, menuItemId, orderId])
  @@index([menuItemId])
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  EXPIRED
  REFUND_REQUIRED
  REFUNDED
}
